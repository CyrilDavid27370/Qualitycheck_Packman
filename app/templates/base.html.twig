<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{% block title %}Qualitycheck_Packman{% endblock %}</title>

    {# Icônes Bootstrap #}
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">

    {# CSS global de l'application #}
    <link rel="stylesheet" href="{{ asset('styles/app.css') }}">

    {% block stylesheets %}{% endblock %}

</head>
<body>
    
    {# Header : logo + infos utilisateur #}
    {% include '_shared/header.html.twig' %}

    {# Navbar : navigation principale #}
    {% include '_shared/nav.html.twig' %}    

    {# Contenu principal — chaque page surcharge ce bloc #}
    <main class="container-fluid py-4">
        {% block body %}{% endblock %}
    </main>

    {# Footer #}
    {% include '_shared/footer.html.twig' %}

    {# Bootstrap JS #}
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>

    {% block javascripts %}
        {% block importmap %}{{ importmap('app') }}{% endblock %} 
    {% endblock %}
</body>
</html>