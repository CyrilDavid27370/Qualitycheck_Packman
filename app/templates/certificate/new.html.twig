{% extends "base.html.twig" %}

{% block title %}Nouveau certificat — {{ categoryType.name }}{% endblock %}

{% block body %}

<div class="qcp-certificate fluid py-3 py-md-4">
    
    {# En-tête #}
    <div class="row mb-4">
        <div class="col-12 d-flex align-items-center gap-3">
            <a href="{{ path('app_dashboard_category', { id: categoryType.id }) }}"
                class="btn btn-outline-secondary">
                    <i class="bi bi-arrow-left"></i>
            </a>
            <div class="flew-grow-1">
                <h2 class="text-warning fw-bold mb-0">
                    <i class="bi bi-clipboard2-plus"></i>
                    Nouveau certificat
                </h2>
                <small class="text-muted">{{ categoryType.category.name }} — {{ categoryType.name }}</small>
            </div>
        </div>
    </div>

    {{ form_start(form, { attr : { novalidate : 'novalidate', id: 'certificate-form' } }) }}

    {# ── Section 1 : En-tête du certificat ─────────────── #}
    <div class="row mb-4">
        <div class="col-12">
            <div class="qcp-certificate__card">
                <h2 class="text-warning mb-3">
                    <i class="bi bi-info-cercle me-2"></i>
                    Informations du certificat 
                </h2>

                <div class="row g-3">
                    <div class="col-12 col-md-6">
                        {{ form_label(form.deliverySite, null, { label_attr: { class: 'form-label text-light' } }) }}
                        {{ form_widget(form.deliverySite) }}
                        {{ form_errors(form.deliverySite) }}
                    </div>
                    <div class="col-12 col-md-6">
                        {{ form_label(form.gpsRef, null, { label_attr: { class: 'form-label text-light' } }) }}
                        {{ form_widget(form.gpsRef) }}
                        {{ form_errors(form.gpsRef) }}
                    </div>
                    <div class="col-12 col-md-6">
                        {{ form_label(form.round, null, { label_attr: { class: 'form-label text-light' } }) }}
                        {{ form_widget(form.round) }}
                        {{ form_errors(form.round) }}
                    </div>
                    <div class="col-12 col-md-6">
                        {{ form_label(form.project, null, { label_attr: { class: 'form-label text-light' } }) }}
                        {{ form_widget(form.project) }}
                        {{ form_errors(form.project) }}
                    </div>
                    <div class="col-12 col-md-6">
                        {{ form_label(form.deliveryDate, null, { label_attr: { class: 'form-label text-light' } }) }}
                        {{ form_widget(form.deliveryDate) }}
                        {{ form_errors(form.deliveryDate) }}
                    </div>
                    <div class="col-12 col-md-6">
                        {{ form_label(form.associatedDerogation, null, { label_attr: { class: 'form-label text-light' } }) }}
                        {{ form_widget(form.associatedDerogation) }}
                        {{ form_errors(form.associatedDerogation) }}
                    </div>
                    <div class="col-12 col-md-6">
                        {{ form_label(form.restrictive, null, { label_attr: { class: 'form-label text-light' } }) }}
                        {{ form_widget(form.restrictive) }}
                        {{ form_errors(form.restrictive) }}
                    </div>
                    <div class="col-12 col-md-6">
                        {{ form_label(form.comodif, null, { label_attr: { class: 'form-label text-light' } }) }}
                        {{ form_widget(form.comodif) }}
                        {{ form_errors(form.comodif) }}
                    </div>
                    <div class="col-12 col-md-6">
                        {{ form_label(form.comments, null, { label_attr: { class: 'form-label text-light' } }) }}
                        {{ form_widget(form.comments) }}
                        {{ form_errors(form.comments) }}
                    </div>

                    {# Cases à cocher #}
                    <div class="col-12 col-md-4">
                        <div class="form-check">
                            {{ form_label(form.hasDerogation, null, { label_attr: { class: 'form-label text-light' } }) }}
                            {{ form-widget(form.hasDerogation)}}
                        </div>
                    </div>
                    <div class="col-12 col-md-4">
                        <div class="form-check">
                            {{ form_label(form.isHare, null, { label_attr: { class: 'form-label text-light' } }) }}
                            {{ form-widget(form.isHare)}}
                        </div>
                    </div>
                    <div class="col-12 col-md-4">
                        <div class="form-check">
                            {{ form_label(form.readyToDeliver, null, { label_attr: { class: 'form-label text-light' } }) }}
                            {{ form-widget(form.readyToDeliver)}}
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
    
    {# ── Section 2 : Critères de vérification ───────────── #}
    <div class="row mb-4">
        <div class="col-12">
            <div class="qcp-certificate__card">
            
            {# Barre d'outils critères #}
            <div class="d-flex justify-content-between align-items-center mb-3 flew-wrap gap-2">
                <h2 class="text-warning mb-0">
                    <i class="bi bi-list-check me-2"></i>
                    Vérification avant livraison
                    <span class="badge bg-secondary ms-2">{{ criterions|length }} items</span>
                </h2>
                <div class="d-flex gap-2 align-items-center">
                    {# Compteur NC #}
                    <span class="badge bg-danger" id="nc-counter" style="display:none;">
                        <i class="bi bi-exclamation-triangle me-1"></i>
                        <span id="nc-count">0</span>
                        NC
                    </span>
                    {# Bouton Tout C #}
                    <button type="button" class="btn btn-sm btn-outline-success" id="btn-all-c">
                        <i class="bi bi-check-all me-1"></i>
                        Tout Conforme
                    </button>
                </div>
            </div>

                {# Table des critères #}
                <div class="table-responsive">
                    <table class="table table-dark table-hover mb-0" id="criteria-table">
                        <thead>
                            <tr>
                                <th style="width: 60px">N°</th>
                                <th>Critère</th>
                                <th style="width: 220px" class="text-center">Cotation</th>
                            </tr>
                        </thead>
                        <tbody>
                            {% for criterion in criterions %}
                                <tr class="criterion-row" data-criterion-id="{{ criterion.id }}">
                                    <td class="text-primary fw-bold align-middle">
                                        {{ criterion.itemNumber }}
                                    </td>
                                    <td class="align-middle">
                                        {{ criterion.label }}
                                    </td>
                                    <td class="text-center align-middle">
                                        {# Boutons radio SO/C/NC stylisés #}
                                        <div class="btn-group rating-group" role="group">
                                        
                                            <input type="radio"
                                                    class="btn-check"
                                                    name="evaluations[{{ criterion.id }}]"
                                                    id="so_{{ criterion.id }}"
                                                    value="SO"
                                                    autocomplete="off">
                                            <label class="btn btn_outline-secondary btn-sm"
                                                    for="so_{{ criterion.id }}">SO
                                            </label>
                                            
                                            <input type="radio"
                                                    class="btn-check"
                                                    name="evaluations[{{ criterion.id }}]"
                                                    id="c_{{ criterion.id }}"
                                                    value="C"
                                                    autocomplete="off">
                                            <label class="btn btn_outline-secondary btn-sm"
                                                    for="c_{{ criterion.id }}">C
                                            </label>
                                            
                                            <input type="radio"
                                                    class="btn-check"
                                                    name="evaluations[{{ criterion.id }}]"
                                                    id="nc_{{ criterion.id }}"
                                                    value="NC"
                                                    autocomplete="off">
                                            <label class="btn btn_outline-secondary btn-sm"
                                                    for="nc_{{ criterion.id }}">NC
                                            </label>
                                            
                                        </div>
                                    </td>
                                </tr>
                            {% endfor %}
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>

    {# ── Bouton de soumission ────────────────────────────── #}
    <div class="row">
        <div class="col-12 d-flex gap-2 justify-content-end">
            <a href="{{ path('app_dashboard_category', { id: categoryType.id }) }}"
                class="btn btn-outline-secondary">
                    <i class="bi bi-x-lg"></i>
                    Annuler
            </a>
            <button type="submit" class="btn btn-warning" id="btn-submit">
                <i class="bi bi-check-lg"></i>
                Valider le certificat
            </button>
        </div>
    </div>

    {{ form_end(form) }}
</div>
{% endblock %}