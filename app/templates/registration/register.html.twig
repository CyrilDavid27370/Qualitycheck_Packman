{% extends "base.html.twig" %}

{% block title %}Enregistrement — QualityCheck Packman{% endblock %}

{% block body %}

<section class="qcp-hero">
    <div class="qcp-hero__card">
    
    {# Logo #}
    <div class="mb-3">
    
        <img src="{{ asset('images/logo_qcp.png') }}" alt="Logo QualityCheck Packman" height="120">
    </div>

    <h2 class="qcp-hero__card-title mb-4">
        <span class="text-warning">Enregistrement</span>
    </h2>

    {# Erreurs globales #}
    {{ form_errors(registrationForm) }}

    {{ form_start(registrationForm, {'attr': {'novalidate' : 'novalidate'}}) }}

        {# Nom #}
        <div class="mb-3 text-start">
            <label class="form-label text-light">
                <i class="bi bi-person"></i>Nom
            </label>
            {{ form_widget(registrationForm.lastName)}}
            {{ form_errors(registrationForm.lastName)}}
        </div>

        {# Prénom #}
        <div class="mb-3 text-start">
            <label class="form-label text-light">
                <i class="bi bi-person"></i>Prénom
            </label>
            {{ form_widget(registrationForm.firstName)}}
            {{ form_errors(registrationForm.firstName)}}
        </div>

        {# Matricule #}
        <div class="mb-3 text-start">
            <label for="registration_form_matricule" class="form-label text-light">
                <i class="bi bi-person-badge"></i>Matricule
            </label>
            {{ form_widget(registrationForm.matricule)}}
            {{ form_errors(registrationForm.matricule)}}
        </div>
        
        {# Mot de passe #}
        <div class="mb-3 text-start">
            <label class="form-label text-light">
                <i class="bi bi-lock"></i> Mot de passe
            </label>
            {{ form_widget(registrationForm.plainPassword.first) }}
            {{ form_errors(registrationForm.plainPassword.first) }}
        </div>

        {# Confirmation mot de passe #}
        <div class="mb-4 text-start">
            <label class="form-label text-light">
                <i class="bi bi-lock-fill"></i> Confirmation du mot de passe
            </label>
            {{ form_widget(registrationForm.plainPassword.second) }}
            {{ form_errors(registrationForm.plainPassword.second) }}
        </div>

        {# Bouton enregistrement #}
        <button type="submit" class="btn btn-primary fw-bold w-100 py-2">
            <i class="bi bi-person-plus"></i>S'enregistrer
        </button>

        {{ form_end(registrationForm) }}

        {# Lien vers connexion #}
        <div class="mt-3">
            <small class="text-muted">
                Déja un compte ?
                <a href="{{ path('app_login') }}" class="text-primary">Se connecter</a>
            </small>
        </div>
    </div>
</section>

{% endblock %}