{% extends 'base.html.twig' %}

{% block title %}Réinitialisation du mot de passe — QCP{% endblock %}

{% block body %}
<div class="container-fluid py-4">
    <div class="row justify-content-center">
        <div class="col-12 col-md-6 col-lg-4">
            <div class="card bg-dark border-secondary shadow">
                <div class="card-body p-4">

                    <div class="text-center mb-4">
                        <img src="{{ asset('images/Logo_qcp.png') }}"
                            alt="Logo QCP" height="60" class="mb-3">
                        <h4 class="text-warning fw-bold mb-1">
                            Mot de passe oublié
                        </h4>
                        <p class="text-muted small mb-0">
                            Saisissez votre matricule pour recevoir un lien de réinitialisation.
                        </p>
                    </div>

                    {# Messages d'erreur #}
                    {% for flash_error in app.flashes('reset_password_error') %}
                        <div class="alert alert-danger alert-dismissible fade show">
                            <i class="bi bi-exclamation-triangle me-2"></i>{{ flash_error }}
                            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                        </div>
                    {% endfor %}

                    {{ form_start(requestForm, { attr: { novalidate: 'novalidate' } }) }}

                        <div class="mb-4">
                            {{ form_label(requestForm.matricule, null, { label_attr: { class: 'form-label text-light' } }) }}
                            {{ form_widget(requestForm.matricule) }}
                            {{ form_errors(requestForm.matricule) }}
                        </div>

                        <button type="submit" class="btn btn-warning w-100">
                            <i class="bi bi-envelope me-2"></i>
                            Envoyer le lien
                        </button>

                    {{ form_end(requestForm) }}

                    <div class="text-center mt-3">
                        <a href="{{ path('app_login') }}" class="text-muted small">
                            <i class="bi bi-arrow-left me-1"></i>
                            Retour à la connexion
                        </a>
                    </div>

                </div>
            </div>
        </div>
    </div>
</div>
{% endblock %}