{% extends 'base.html.twig' %}

{% block title %}Définir votre mot de passe — QCP{% endblock %}

{% block stylesheets %}
    <link rel="stylesheet" href="{{ asset('styles/general.css') }}">
{% endblock %}

{% block body %}
<div class="container-fluid py-4">
    <div class="row justify-content-center">
        <div class="col-12 col-md-6 col-lg-4">
            <div class="card bg-dark border-secondary shadow">
                <div class="card-body p-4">

                    <div class="text-center mb-4">
                        <img src="{{ asset('images/Logo_qcp.png') }}"
                            alt="Logo QCP" height="60" class="mb-3">
                        <h2 class="text-warning fw-bold mb-1">
                            Définir votre mot de passe
                        </h2>
                        <p class="text-muted small mb-0">
                            Choisissez un mot de passe sécurisé pour votre compte.
                        </p>
                    </div>

                    {{ form_start(resetForm, { attr: { novalidate: 'novalidate' } }) }}

                        <div class="mb-3">
                            {{ form_label(resetForm.plainPassword.first, null, { label_attr: { class: 'form-label text-light' } }) }}
                            {{ form_widget(resetForm.plainPassword.first) }}
                            {{ form_errors(resetForm.plainPassword.first) }}
                        </div>

                        <div class="mb-4">
                            {{ form_label(resetForm.plainPassword.second, null, { label_attr: { class: 'form-label text-light' } }) }}
                            {{ form_widget(resetForm.plainPassword.second) }}
                            {{ form_errors(resetForm.plainPassword.second) }}
                        </div>

                        <button type="submit" class="btn btn-warning w-100">
                            <i class="bi bi-check-lg me-2"></i>
                            Définir mon mot de passe
                        </button>

                    {{ form_end(resetForm) }}

                </div>
            </div>
        </div>
    </div>
</div>
{% endblock %}