{% extends "base.html.twig" %}

{% block title %}{{ isEdit ? 'Modifier' : 'Nouvel' }} utilisateur — Admin QCP{% endblock %}

{% block body %}
<div class="qcp-admin container-fluid py-3 py-md-4">

{# En-tête #}
  <div class="row mb-4">
    <div class="col-12 d-flex align-items-center gap-3">
        <a href="{{ path('app_admin_user_index') }}" class="btn btn-outline-secondary">
          <i class="bi bi-arrow-left"></i>
        </a>
        <h2 class="text-warning fw-bold mb-0">
          <i class="bi bi-person-{{ isEdit ? 'gear' : 'plus' }}"></i>
          {{ isEdit ? 'Modifier' : 'Nouvel'}} utilisateur
        </h2>
    </div>
  </div>

{# Formulaire #}
<div class="row">
  <div class="col-12">
    <div class="qcp-admin__form-card">
    
      {{ form_start(form, {attr: { novalidate: 'novalidate' } }) }}

        <div class="mb-3">
          {{ form_label(form.lastname,null, { label_attr: { class: 'form-label text-light' } }) }}
          {{ form_widget(form.lastname) }}
          {{ form_errors(form.lastname) }}
        </div>

        <div class="mb-3">
          {{ form_label(form.firstname,null, { label_attr: { class: 'form-label text-light' } }) }}
          {{ form_widget(form.firstname) }}
          {{ form_errors(form.firstname) }}
        </div>

        <div class="mb-3">
          {{ form_label(form.matricule,null, { label_attr: { class: 'form-label text-light' } }) }}
          {{ form_widget(form.matricule) }}
          {{ form_errors(form.matricule) }}
        </div>

        <div class="mb-3">
          {{ form_label(form.roles,null, { label_attr: { class: 'form-label text-light' } }) }}
          {{ form_widget(form.roles) }}
          {{ form_errors(form.roles) }}
        </div>

        <div class="mb-3 form-check">
          {{ form_label(form.active,null, { label_attr: { class: 'form-label text-light' } }) }}
          {{ form_widget(form.active)}}
          {{ form_errors(form.active)}}
        </div>

        <div class="mb-4">
          {{ form_label(form.plainPassword,null, { label_attr: { class: 'form-label text-light' } }) }}
          {{ form_widget(form.plainPassword)}}
          {{ form_errors(form.plainPassword)}}
        </div>

        <div class="d-flex gap-2">
          <button type="submit" class="btn btn-warning">
            <i class="bi bi-check-lg"></i>
            {{ isEdit ? 'Modifier' : 'Ajouter'}}
          </button>
          <a href="{{ path('app_admin_user_index') }}" class="btn btn-outline-secondary">
            <i class="bi bi-x-lg"></i>
            Annuler
          </a>
        </div>

        {{ form_end(form) }}
    </div>
  </div>
</div>
</div>

{% endblock %}