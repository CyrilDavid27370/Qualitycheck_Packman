{% extends "base.html.twig" %}

{% block title %}{{ isEdit ? 'Modifier' : 'Nouvelle' }} catégorie — Admin QCP{% endblock %}

{% block body %}
    <div class="qcp-admin container-fluid py-3 py-md-4">
    
      {# En-tête #}
      <div class="row mb-4">
          <div class="col-12 d-flex align-items-center gap-3">
            <a href="{{ path('app_admin_category_index') }}" class="btn btn-outline-secondary">
              <i class="bi bi-arrow-left"></i>
            </a>
            <h2 class="text-warning fw-bold mb-0">
              <i class="bi bi-tag"></i>
              {{ isEdit ? 'Modifier' : 'Nouvelle' }} catégorie
            </h2>
          </div>
      </div>

    {# Formulaire #}
    <div class="row">
      <div class="col-12">
        <div class="qcp-admin__form-card">
        
        {{ form_start(form, { attr: { novalidate: 'novalidate' } }) }}

          <div class="mb-4">
            {{ form_label(form.name, null, { label_attr: { class: 'form-label text-light' } }) }}
            {{ form_widget(form.name) }}
            {{ form_errors(form.name) }}
          </div>

          <div class="d-flex gap-2">
            <button type="submit" class="btn btn-primary">
              <i class="bi bi-check-lg"></i>
              {{ isEdit ? 'Modifier' : 'Ajouter' }}
            </button>
            <a href="{{ path('app_admin_category_index') }}" class="btn btn-outline-secondary">
              <i class="bi bi-x-lg"></i>
              Annuler
            </a>
          </div>

        {{ form_end(form) }}

        </div>
      </div>
    </div>

  </div>
{% endblock %}