{% extends "base.html.twig" %}

{% block title %}Gestion des catégories — Admin QCP{% endblock %}

{% block body %}
<div class="qcp-admin container-fluid py-3 py-md-4">

    {% set categoryColors = {
        'Moteur thermique' : 'danger',
        'GMPE'             : 'primary',
        'E-Motor'          : 'success',
        'Module'           : 'info',
        'Batterie'         : 'warning'
    } %}

    {# En-tête #}
    <div class="row mb-4">
        <div class="col-12 d-flex justify-content-between align-items-center">
            <h2 class="text-warning fw-bold mb-0">
                <i class="bi bi-tags"></i> Catégories
            </h2>
            <a href="{{ path('app_admin_category_save') }}" class="btn btn-warning">
                <i class="bi bi-plus-lg"></i>
                <span class="d-none d-md-inline">Nouvelle catégorie</span>
            </a>
        </div>
    </div>

    {# Messages flash #}
    {% for message in app.flashes('success') %}
        <div class="alert alert-success alert-dismissible fade show">
            <i class="bi bi-check-circle me-2"></i>{{ message }}
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    {% endfor %}

    {% for message in app.flashes('warning') %}
        <div class="alert alert-warning alert-dismissible fade show">
            <i class="bi bi-exclamation-triangle me-2"></i>{{ message }}
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    {% endfor %}

    {# Table des catégories #}
    <div class="row">
        <div class="col-12">
            <div class="card bg-dark border-secondary shadow">
                <div class="card-body p-0">
                    <div class="table-responsive">
                        <table class="table table-dark table-hover mb-0">
                            <thead>
                                <tr>
                                    <th>Catégorie</th>
                                    <th class="d-none d-md-table-cell">Types associés</th>
                                    <th class="text-end">Actions</th>
                                </tr>
                            </thead>
                            <tbody>
                                {% for category in categories %}
                                    {% set color = categoryColors[category.name] ?? 'secondary' %}
                                    <tr>
                                        <td class="fw-bold text-{{ color }} align-middle">
                                            {{ category.name }}
                                        </td>

                                        {# Colonne types — visible sur tous les écrans #}
                                        <td>
                                            <div class="row g-1">
                                                {% for type in category.categoryTypes %}
                                                    <div class="col-12 col-md-4">
                                                        <div class="d-flex align-items-center gap-1">
                                                            <span class="badge border border-{{ color }} text-{{ color }} text-truncate w-100">
                                                            {{ type.name }}
                                                            </span>
                                                            <a href="{{ path('app_admin_categoryType_save', { id: type.id }) }}"
                                                                class="btn btn-sm btn-outline-warning py-0 px-1 flex-shrink-0"
                                                                title="Modifier {{ type.name }}">
                                                                    <i class="bi bi-pencil"></i>
                                                            </a>
                                                            <form action="{{ path('app_admin_categoryType_delete', { id: type.id }) }}"
                                                                    method="POST"
                                                                    class="d-inline flex-shrink-0"
                                                                    onsubmit="return confirm('Supprimer le type {{ type.name }} ?')">
                                                                <input type="hidden" name="_token"
                                                                        value="{{ csrf_token('delete_type_' ~ type.id) }}">
                                                                <button type="submit"
                                                                        class="btn btn-sm btn-outline-danger py-0 px-1"
                                                                        title="Supprimer {{ type.name }}">
                                                                            <i class="bi bi-trash"></i>
                                                                </button>
                                                            </form>
                                                            <a href="{{ path('app_admin_criterion_index', { categoryTypeId: type.id }) }}"
                                                                class="btn btn-sm btn-outline-info py-0 px-1 flex-shrink-0"
                                                                title="Voir les critères">
                                                                    <i class="bi bi-list-check"></i>
                                                            </a>
                                                        </div>
                                                    </div>
                                                {% else %}
                                                    <div class="col-12">
                                                        <span class="text-muted">Aucun type</span>
                                                    </div>
                                                {% endfor %}

                                                <div class="col-12 mt-1">
                                                    <a href="{{ path('app_admin_categoryType_save') }}"
                                                        class="btn btn-sm btn-outline-success">
                                                            <i class="bi bi-plus-lg"></i> Ajouter un type
                                                    </a>
                                                </div>
                                            </div>
                                        </td>

                                        {# Actions catégorie #}
                                        <td class="text-end align-middle">
                                            <a href="{{ path('app_admin_category_save', { id: category.id }) }}"
                                                class="btn btn-sm btn-outline-warning me-1"
                                                title="Modifier">
                                                    <i class="bi bi-pencil"></i>
                                            </a>
                                            <form action="{{ path('app_admin_category_delete', { id: category.id }) }}"
                                                    method="POST"
                                                    class="d-inline"
                                                    onsubmit="return confirm('Supprimer la catégorie {{ category.name }} ?')">
                                                <input type="hidden" name="_token"
                                                        value="{{ csrf_token('delete_category_' ~ category.id) }}">
                                                <button type="submit"
                                                        class="btn btn-sm btn-outline-danger"
                                                        title="Supprimer">
                                                    <i class="bi bi-trash"></i>
                                                </button>
                                            </form>
                                        </td>
                                    </tr>
                                {% else %}
                                    <tr>
                                        <td colspan="3" class="text-center text-muted py-5">
                                            <i class="bi bi-tags fs-3 d-block mb-2 opacity-50"></i>
                                            Aucune catégorie trouvée.
                                        </td>
                                    </tr>
                                {% endfor %}
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>

</div>
{% endblock %}