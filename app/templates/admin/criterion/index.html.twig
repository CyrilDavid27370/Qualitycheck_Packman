{% extends "base.html.twig" %}

{% block title %}Critères — {{ categoryType.name }}{% endblock %}

{% block stylesheets %}
    <link rel="stylesheet" href="{{ asset('styles/admin.css') }}">
{% endblock %}

{% block body %}
<div class="qcp-admin container-fluid py-3 py-md-4">

    {# En-tête #}
    <div class="row mb-4">
        <div class="col-12 d-flex align-items-center gap-3">
            <a href="{{ path('app_admin_category_index') }}" class="btn btn-outline-secondary flex-shrink-0">
                <i class="bi bi-arrow-left"></i>
            </a>
            <div class="flex-grow-1">
                <h2 class="text-warning fw-bold mb-0">
                    <i class="bi bi-list-check"></i>
                    Critères
                </h2>
                <small class="text-muted">
                    {{ categoryType.category.name }} — {{ categoryType.name }}
                </small>
            </div>
            <a href="{{ path('app_admin_criterion_save', { categoryTypeId: categoryType.id }) }}"
                class="btn btn-warning flex-shrink-0">
                <i class="bi bi-plus-lg"></i>
                <span class="d-none d-md-inline">Nouveau critère</span>
            </a>
        </div>
    </div>

    {# Messages flash #}
    {% for message in app.flashes('success') %}
        <div class="alert alert-success alert-dismissible fade show">
            <i class="bi bi-check-circle me-2"></i>{{ message }}
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    {% endfor %}

    {% for message in app.flashes('warning') %}
        <div class="alert alert-warning alert-dismissible fade show">
            <i class="bi bi-exclamation-triangle me-2"></i>{{ message }}
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    {% endfor %}

    {# Table des critères #}
    <div class="row">
        <div class="col-12">
            <div class="card bg-dark border-secondary shadow">
                <div class="card-body p-0">
                    <div class="table-responsive">
                        <table class="table table-dark table-hover mb-0">
                            <thead>
                                <tr>
                                    <th style="width: 60px">N°</th>
                                    <th>Libellé</th>
                                    <th class="text-end">Actions</th>
                                </tr>
                            </thead>
                            <tbody>
                                {% for criterion in criterions %}
                                    <tr>
                                        <td class="text-warning fw-bold align-middle">
                                            {{ criterion.itemNumber }}
                                        </td>
                                        <td class="align-middle">
                                            {{ criterion.label }}
                                        </td>
                                        <td class="text-end align-middle">
                                            {# Modifier #}
                                            <a href="{{ path('app_admin_criterion_save', { categoryTypeId: categoryType.id, id: criterion.id }) }}"
                                                class="btn btn-sm btn-outline-warning me-1"
                                                title="Modifier">
                                                <i class="bi bi-pencil"></i>
                                            </a>
                                            {# Supprimer #}
                                            <form action="{{ path('app_admin_criterion_delete', { id: criterion.id }) }}"
                                                  method="POST"
                                                  class="d-inline"
                                                  onsubmit="return confirm('Supprimer le critère n°{{ criterion.itemNumber }} ?')">
                                                <input type="hidden" name="_token"
                                                        value="{{ csrf_token('delete_criterion_' ~ criterion.id) }}">
                                                <button type="submit"
                                                        class="btn btn-sm btn-outline-danger"
                                                        title="Supprimer">
                                                    <i class="bi bi-trash"></i>
                                                </button>
                                            </form>
                                        </td>
                                    </tr>
                                {% else %}
                                    <tr>
                                        <td colspan="3" class="text-center text-muted py-5">
                                            <i class="bi bi-list-check fs-3 d-block mb-2 opacity-50"></i>
                                            Aucun critère pour ce type.
                                        </td>
                                    </tr>
                                {% endfor %}
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>

</div>
{% endblock %}