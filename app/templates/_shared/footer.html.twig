{#
    _shared/footer.html.twig
    Pied de page de l'application QCP.
    Inclus automatiquement dans base.html.twig.
#}

<footer class="qcp-footer py-3 mt-auto">
  <div class="container-fluid d-flex align-items-center justify-content-between px-4">

  {# Logo QCP #}
  <div class="qcp-footer_brand">
    <img src="{{ asset('images/Logo_qcp.png') }}" alt="Logo QualityCheck Packman" height="60">
  </div>

  {# Copyright centré #}
  <small class="text-light text-center grow">
  &copy; {{ "now"|date("Y") }} QualityCheck_<span class="text-warning">Packman</span>
  Tous droits réservés.
    &mdash; v1.0.0
  </small>

  {# Initiales + date à droite (visible dans le wireframe) #}
  <small class="text-muted" style="font-size: 1rem;">
    {% if app.user %}
        <span class="text-warning fw-bold">{{ app.user.matricule }}</span>
          &mdash; {{ "now"|date("d/m/Y") }}
    {% else %}
        {{ "now"|date("d/m/Y") }}
    {% endif %}
  </small>
</div>
</footer>
