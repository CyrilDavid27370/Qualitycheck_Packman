{#
    _shared/header.html.twig
    Header principal QCP — 3 colonnes :
    - Gauche  : logo
    - Centre  : titre (centré)
    - Droite  : infos utilisateur connecté
#}

<header class="qcp-header px-3 px-md-4 py-2">
    <div class="d-flex align-items-center justify-content-around w-100">

        {# Colonne gauche — Logo QCP #}
        <div class="qcp-header__brand">
            <a href="{{ path('app_home') }}">
                <img
                    src="{{ asset('images/logo_qcp.png') }}"
                    alt="Logo QualityCheck Packman"
                    class="qcp-header__logo"
                >
            </a>
        </div>

        {# Colonne centre — Titre centré #}
        <div class="qcp-header__title text-center">
            <span class="text-light fw-bold">QualityCheck</span>
            <span class="text-warning fw-bold">Packman</span>
        </div>

        {# Colonne droite — Infos utilisateur connecté #}
        {% if app.user %}
            <div class="qcp-header__user d-flex align-items-center gap-2">
                <i class="bi bi-person-circle text-warning"></i>
                <span class="text-light small">{{ app.user.matricule }}</span>
                <a href="{{ path('app_logout') }}" class="btn btn-sm btn-outline-warning ms-1">
                    <i class="bi bi-box-arrow-right"></i>
                </a>
            </div>
        {% else %}
            {# Colonne droite vide si non connecté — garde le centrage du titre #}
            <div style="width: 60px;"></div>
        {% endif %}

    </div>
</header>
