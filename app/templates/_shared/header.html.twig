{#
    _shared/header.html.twig
    Header principal QCP — 3 colonnes :
    - Gauche  : logo
    - Centre  : titre (centré)
    - Droite  : infos utilisateur connecté
#}

<header class="qcp-header px-3 px-md-4 py-2">
    <div class="d-flex align-items-center justify-content-between w-100">

        {# Colonne gauche — Logo QCP #}
        <div class="qcp-header__brand">
            <a href="{{ path('app_home') }}">
                <img
                    src="{{ asset('images/logo_qcp.png') }}"
                    alt="Logo QualityCheck Packman"
                    class="qcp-header__logo"
                >
            </a>
        </div>

        {# Colonne centre — Titre centré #}
        <div class="qcp-header__title text-center">
            <span class="text-light fw-bold">QualityCheck</span><br>
            <span class="text-warning fw-bold">Packman</span>
        </div>

        {# Colonne droite — Infos utilisateur connecté #}
        {% if app.user %}
            <div class="qcp-header__user d-flex flex-column align-items-end gap-1">
                <span class="qcp-header__matricule text-warning">
                    <i class="bi bi-person-circle"></i>
                    {{ app.user.matricule }}
                </span>
                <a href="{{ path('app_logout') }}"
                    class="btn btn-sm btn-outline-warning"
                    title="Se déconnecter">
                    <i class="bi bi-box-arrow-right"></i>
                    <span class="d-none d-md-inline">Déconnexion</span>
                </a>
            </div>
        {% else %}
            <div class="qcp-header__user"></div>
        {% endif %}

    </div>
</header>
