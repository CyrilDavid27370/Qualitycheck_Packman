{% extends "base.html.twig" %}

{% block title %}Dashboard — QualityCheck Packman{% endblock %}

{% block body %}

<div class="qcp-dashboard container-fluid py-4">

 {# ── En-tête ─────────────────────────────────────────────
    col-12 sur tous les écrans
    Titre réduit sur mobile (fs-5), pleine taille sur desktop
    ──────────────────────────────────────────────────────────#}

    <div class="row mb-3 mb-md-4">
        <div class="col-12 text-center">
            <h2 class="text-warning fw-bold fs-5 fs-md-4 fs-lg-2">
                <i class="bi bi-speedometer2"></i>
                Tableau de bord
            </h2>
            <p class="text-primary small mb-0">
                Bienvenue 
                {# app.user.firstname → getFirstname()
                app.user.lastname  → getLastname()
                Fallback sur le matricule si nom/prénom non renseignés #}
                {% if app.user.firstname and app.user.lastname %}
                    <strong class="text-light">
                        {{ app.user.firstName }} {{ app.user.lastName }}
                    </strong>
                {% else %}
                    <strong class="text-light">
                        {{ app.user.userIdentifier}}
                    </strong>
                {% endif %}
                - Sélectionner une catégorie dans le menu pour commencer.
            </p>
        </div>
    </div>

    {# ── Zone de contenu principale ───────────────────────────
    Sur mobile    (< md) : pleine largeur, padding réduit
    Sur tablette  (md)   : pleine largeur, padding normal
    Sur desktop   (lg+)  : pleine largeur, padding confortable
    Le min-height est géré dans dashboard.css via --qcp-*
    ──────────────────────────────────────────────────────────#}

    <div class="row">
        <div class="col-12">
            <div class="qcp-dashboard__content">
            
                {% block dashboard_content %}
                
                {# ── Placeholder ─────────────────────────────────────
                    Centré verticalement et horizontalement sur tous
                    les écrans grâce aux classes Bootstrap d-flex
                    ────────────────────────────────────────────────────#}
                <div class="d-flex flex-column align-items-center 
                            justify-content-center text-center
                            py-4 py-md-5 text-muted qcp-welcome-card">
                
                    <i class="bi bi-clipboard2-check text-warning opacity-50
                                fs-1 fs-md-1 mb-3">
                    </i>

                    <p class="mb-0 px-3 px-md-0">
                        Aucun certificat sélectionné. <br>
                        Choisisez une categorie dans la barre de navigation.
                    </p>
                </div>
                
                {% endblock %}
                
            </div>
        </div>
    </div>

</div>


{% endblock %}