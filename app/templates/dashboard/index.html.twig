{% extends "base.html.twig" %}

{% block title %}Dashboard — QualityCheck Packman{% endblock %}

{% block body %}

<div class="qcp-dashboard container-fluid py-4">

    <div class="row mb-4">
        <div class="col">
            <h2 class="text-warning fw-bold">
                <i class="bi bi-speedometer2"></i>
                Tableau de bord
            </h2>
            <p class="text-muted">
                Bienvenue <strong class="text-light">{{ app.user.firstName }} {{ app.user.lastName }}</strong>
                Sélectionner une catégorie dans le menu pour commencer.
            </p>
        </div>
    </div>

    {# Zone de contenu principale — sera remplie dynamiquement #}
    <div class="row">
        <div class="col">
            <div class="qcp-dashboard__content">
            
                {# Placeholder — sera remplacé par les certificats / formulaires #}
                <div class="text-center py-5 text-muted">
                    <i class="bi bi-clipboard2-check fs-1 text-warning opacity-50"></i>
                    <p class="mt-3">Aucun certificat sélectionné.<br>
                    Choissisez une categorie dans la barre de navigation</p>
                </div>

            </div>
        </div>
    </div>

</div>


{% endblock %}